# 複製成 VM 上的 .env.production，再填入實際值。
#
# LINE Login 必填：
AUTH_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# VM 自管 Postgres 必填。正式值不要提交到 Git。
DATABASE_URL=postgres://caretaiwan:change-me@postgres:5432/caretaiwan
POSTGRES_SSL_MODE=disable
POSTGRES_POOL_MAX=5
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=30000

# LINE Bot 推播 / webhook 必填：
LINE_BOT_CHANNEL_SECRET=
LINE_BOT_CHANNEL_ACCESS_TOKEN=

# 選填：
NEXT_PUBLIC_SENTRY_DSN=
CRON_SECRET=
PREVIEW_ALLOWED_HOSTS=
PUBLIC_APP_URL=
PRODUCTION_ALLOWED_HOSTS=
APP_PORT=3033
LOCAL_PHOTO_STORAGE_DIR=/app/photo-storage
LOCAL_PHOTO_SIGNING_SECRET=
