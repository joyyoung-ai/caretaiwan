# Copy this file to .env.production on the NAS and fill real values.
#
# Required for LINE Login:
AUTH_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Required for cloud pairing / backup:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for LINE Bot push / webhook:
LINE_BOT_CHANNEL_ID=
LINE_BOT_CHANNEL_SECRET=
LINE_BOT_CHANNEL_ACCESS_TOKEN=

# POC only. Allows one LINE account to act as both family and caregiver.
# Keep false in any real deployment.
POC_ALLOW_SELF_PAIRING=false

# Optional:
NEXT_PUBLIC_SENTRY_DSN=
CRON_SECRET=
PREVIEW_ALLOWED_HOSTS=demo3.cosmosdesign.tw
PUBLIC_APP_URL=https://demo3.cosmosdesign.tw
LOCAL_PHOTO_STORAGE_DIR=/app/photo-storage
LOCAL_PHOTO_SIGNING_SECRET=
