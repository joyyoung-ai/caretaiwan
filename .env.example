# CareTaiwan 環境變數範例
# 複製成 .env.local 後填入實際值；不要把 .env.local 提交到 Git。

# Auth.js / LINE Login
AUTH_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# VM 自管 Postgres（只允許伺服器端使用）
DATABASE_URL=postgres://caretaiwan:change-me@localhost:5432/caretaiwan
POSTGRES_SSL_MODE=disable
POSTGRES_POOL_MAX=5
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=30000

# LINE Messaging API / 家屬端 Bot
LINE_BOT_CHANNEL_SECRET=
LINE_BOT_CHANNEL_ACCESS_TOKEN=

# Cron / 資料保留期限清理
CRON_SECRET=

# Rate limit（公開部署建議設定）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Preview / production host allowlist
PREVIEW_ALLOWED_HOSTS=
PUBLIC_APP_URL=
PRODUCTION_ALLOWED_HOSTS=

# VM local photo storage（正式環境必填，Docker 請掛 persistent volume）
LOCAL_PHOTO_STORAGE_DIR=
LOCAL_PHOTO_SIGNING_SECRET=

# 選填：Sentry
NEXT_PUBLIC_SENTRY_DSN=
