# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local deployment artifacts
/.npm-cache/
/docker/*.tar

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!/.env.example
!/docker/.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# claude code local settings (per-machine permission allowlist)
.claude/settings.local.json

# local-only agent notes
AGENTS.local.md

# personal marketing / outreach docs (exclude before open-sourcing)
OUTREACH_TADA.md
LINKEDIN_POST.md
PORTFOLIO_ENTRY.md
CODEX_REVIEW_BRIEF.md
